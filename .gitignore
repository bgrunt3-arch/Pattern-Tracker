# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# フルサイズmockupはVercel Blob(private)に保存しコミットしない
public/mockups/
!public/mockups/.gitkeep
# 軽量サムネ(mockup-thumbs)は静的配信のためコミットする
# （private Blobはコンテンツ取得が403で不可のため静的配信に切替）
